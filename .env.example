# Copy this file to .env for local development.
# On Railway, configure the same variables in the project dashboard under Variables.
# You can get the Supabase values from: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: if you also use Vapi from the backend, store the API token here.
# Example: copy your Vapi API key from the Vapi dashboard, then set it in Railway as VAPI_API_KEY.
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Optional: local dev server config
PORT=8000
