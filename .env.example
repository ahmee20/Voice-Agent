# Copy this file to .env for local development.
# On Railway, configure the same variables in the project dashboard under Variables.
# For SQLAlchemy, SUPABASE_URL must be the synchronous Postgres connection string.
# Do not use postgresql+asyncpg:// here; use the plain postgresql:// URL instead.
# You can get it from: Supabase -> Project Settings -> Database -> Connection string
SUPABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Optional: if you also use Vapi from the backend, store the API token here.
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Optional: local dev server config
PORT=8000
